# SmartBus Environment Configuration Example
# Copy to .env or configure in app/config/database.php

APP_ENV=development
APP_DEBUG=true

# Database Settings (Standard XAMPP default)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=smartbus
DB_USER=root
DB_PASS=

# Session Lifetime (seconds)
SESSION_LIFETIME=604800

